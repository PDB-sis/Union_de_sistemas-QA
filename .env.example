# Configuración de "docker compose" (copiar a .env y completar). .env nunca se sube al repositorio.

# --- Secretos (obligatorios; use valores largos y distintos en cada instalación) ---
# Contraseña de PostgreSQL (usuario postgres de la base sistemas_unificados).
POSTGRES_PASSWORD=
# Firma de las sesiones de NEXO QA (32 caracteres o más).
NEXOQA_JWT_SECRET=
# Secreto compartido del acceso único PDMC -> NEXO QA (32 caracteres o más).
SSO_SECRET=

# --- Versión de las imágenes de Docker Hub (sistemaspdb/*) ---
VERSION=latest

# --- Puertos en este equipo ---
PDMC_PUERTO=3000
NEXOQA_PUERTO=8080
NEXOQA_API_PUERTO=5082
POSTGRES_PUERTO=55450

# --- Orígenes públicos (exactamente como se abren en el navegador; HTTP solo para localhost) ---
PDMC_ORIGEN=http://localhost:3000
NEXOQA_ORIGEN=http://localhost:8080

# --- Sincronización de PDMC ---
# Sitio cuyo inventario usa PDMC (dimID_Tienda; 2004 = BODEGA MARACAIBO).
PDMC_INVENTARIO_DIM_ID=2004
# Cuenta de sistema a cuyo nombre se registran las cargas de inventario.
PDMC_SYNC_USUARIO_EMAIL=sincronizacion@pdmc.local
# Catálogo de sitios (BODEGA_DATOS): lo único que se consulta en SQL Server, en solo lectura.
# Con false, PDMC funciona con lo que envían los agentes y el catálogo de sitios no se actualiza.
PDMC_SQLSERVER_ENABLED=false
PDMC_SQLSERVER_HOST=
PDMC_SQLSERVER_INSTANCE=
PDMC_SQLSERVER_PORT=
PDMC_SQLSERVER_DATABASE=
PDMC_SQLSERVER_USER=
PDMC_SQLSERVER_PASSWORD=
PDMC_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
