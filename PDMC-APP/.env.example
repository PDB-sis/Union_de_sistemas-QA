# Solo servidor. No usar prefijo NEXT_PUBLIC_. Completar en .env.local.
# URL orientativa: postgresql://USUARIO:CLAVE@localhost:5432/pdmc?schema=public
# Codificar caracteres especiales de usuario/clave con percent-encoding.
DATABASE_URL=

# Migración única hacia una base nueva. Retirar del entorno al terminar.
PDMC_SOURCE_DATABASE_URL=
PDMC_MIGRATION_ADMIN_EMAIL=

# Seed opcional: código y nombre de UNA bodega real. No crea datos de demostración.
SEED_BODEGA_CODIGO=
SEED_BODEGA_NOMBRE=

# Origen único de autenticación. HTTP solo en localhost/127.0.0.1.
# En producción debe coincidir con la URL pública exacta del servidor.
PDMC_AUTH_ORIGIN=http://localhost:3000
# Opcional: otros enlaces HTTPS propios separados por comas (p. ej. Tailscale Serve).
PDMC_AUTH_ADDITIONAL_ORIGINS=

# Consultas automáticas a SQL Server (reemplazan la carga manual de CSV).
# Mantener desactivado hasta crear el usuario de solo lectura. Nunca usar NEXT_PUBLIC_.
PDMC_SQLSERVER_ENABLED=false
PDMC_SQLSERVER_HOST=
# Instancia con nombre: SERVIDOR\INSTANCIA → HOST=SERVIDOR, INSTANCE=INSTANCIA y PORT vacío.
PDMC_SQLSERVER_INSTANCE=
PDMC_SQLSERVER_PORT=
PDMC_SQLSERVER_DATABASE=GDC_CASA_MATRIZ
PDMC_SQLSERVER_USER=
PDMC_SQLSERVER_PASSWORD=
# true solo en desarrollo con un certificado SQL Server de prueba/autofirmado.
PDMC_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
PDMC_SQLSERVER_TIMEOUT_SECONDS=300
# Módulos a ejecutar (por defecto todos): SUCURSALES,FACTURADORES,TRANSFERENCIAS,DEVOLUCIONES,INVENTARIO
PDMC_SYNC_MODULOS=
PDMC_SYNC_SUCURSALES_SEGUNDOS=3600
PDMC_SYNC_FACTURADORES_SEGUNDOS=3600
PDMC_SYNC_TRANSFERENCIAS_SEGUNDOS=60
PDMC_SYNC_DEVOLUCIONES_SEGUNDOS=60
PDMC_SYNC_INVENTARIO_SEGUNDOS=900
# Cuenta de sistema (sin contraseña) a cuyo nombre se registran las cargas de inventario.
# Se crea con: npm run sync:crear-usuario. Ejemplo: sincronizacion@empresa.com
PDMC_SYNC_USUARIO_EMAIL=
# Opcionales: archivos TLS externos; por defecto el iniciador usa .secrets.
PDMC_TLS_PFX_FILE=
PDMC_TLS_PASSWORD_FILE=

# Recuperación por operador del servidor: npm run administrar-usuario
# El responsable debe ser un Administrador habilitado existente.
PDMC_ADMIN_ACTOR_EMAIL=
PDMC_ADMIN_USUARIO_EMAIL=
PDMC_ADMIN_MOTIVO=
# Configurar una sola operación: contraseña temporal O estado.
PDMC_ADMIN_PASSWORD_TEMPORAL=
PDMC_ADMIN_ESTADO=

# Sesión 2.2: npm run administrar-accesos. Ver docs/sesion-2.2.md.
# Reemplaza todas las asignaciones del usuario. null indica alcance nacional.
# Configure el JSON de asignaciones O el JSON de ubicación, una operación a la vez.
PDMC_ACCESO_USUARIO_EMAIL=
PDMC_ACCESO_ASIGNACIONES=
PDMC_UBICACION=
