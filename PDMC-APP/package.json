{
  "name": "panel-mejora-continua",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:architecture && npm run check:texts && prisma generate && next build",
    "start": "node scripts/servidor-pdmc.mjs",
    "lint": "eslint . && npm run check:architecture && npm run check:texts",
    "check:texts": "node scripts/verificar-textos.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node --conditions=react-server --import tsx --test tests/*.test.mjs",
    "test:integration": "prisma generate && node --conditions=react-server --import tsx --test tests/*.integration.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:local:prepare": "node scripts/preparar-postgres-local.mjs",
    "db:check": "node --conditions=react-server --import tsx scripts/verificar-postgres.ts",
    "db:audit": "node --conditions=react-server --import tsx scripts/auditar-estabilidad.ts",
    "sync:sqlserver": "node --conditions=react-server --import tsx scripts/sincronizar-sqlserver.ts",
    "sync:sqlserver:once": "node --conditions=react-server --import tsx scripts/sincronizar-sqlserver.ts --once",
    "sync:crear-usuario": "node --conditions=react-server --import tsx scripts/crear-usuario-sincronizacion.ts",
    "db:migrar-admin-limpio": "prisma generate && node --conditions=react-server --import tsx scripts/migrar-administrador-limpio.ts",
    "db:limpiar-inicio": "node scripts/limpiar-inicio-oficial.mjs",
    "crear-usuarios-iniciales": "node --conditions=react-server --import tsx scripts/crear-usuarios-iniciales.ts",
    "administrar-usuario": "node --conditions=react-server --import tsx scripts/administrar-usuario.ts",
    "administrar-accesos": "node --conditions=react-server --import tsx scripts/administrar-accesos.ts",
    "check:architecture": "node scripts/verificar-arquitectura.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@next/env": "16.3.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.468.0",
    "mssql": "^12.2.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/mssql": "^9.1.9",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4.2.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
