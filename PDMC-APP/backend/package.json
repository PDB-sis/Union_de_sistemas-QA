{
  "name": "pdmc-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de PDMC: autenticación, permisos, reglas de negocio, PostgreSQL (Prisma) y sincronización con SQL Server.",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "start:con-frontend": "node --import tsx src/server.ts --frontend",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "prisma generate && node --import tsx --test tests/*.test.mjs",
    "test:integration": "prisma generate && node --import tsx --test tests/*.integration.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:local:prepare": "node scripts/preparar-postgres-local.mjs",
    "db:check": "node --import tsx scripts/verificar-postgres.ts",
    "db:audit": "node --import tsx scripts/auditar-estabilidad.ts",
    "db:migrar-admin-limpio": "prisma generate && node --import tsx scripts/migrar-administrador-limpio.ts",
    "db:limpiar-inicio": "node --import tsx scripts/limpiar-inicio-oficial.mjs",
    "sync:sqlserver": "node --import tsx scripts/sincronizar-sqlserver.ts",
    "sync:sqlserver:once": "node --import tsx scripts/sincronizar-sqlserver.ts --once",
    "sync:crear-usuario": "node --import tsx scripts/crear-usuario-sincronizacion.ts",
    "crear-usuarios-iniciales": "node --import tsx scripts/crear-usuarios-iniciales.ts",
    "administrar-usuario": "node --import tsx scripts/administrar-usuario.ts",
    "administrar-accesos": "node --import tsx scripts/administrar-accesos.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@pdmc/contratos": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.14",
    "mssql": "^12.2.0",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@eslint/js": "^9.39.5",
    "@types/mssql": "^9.1.9",
    "@types/node": "^22.19.19",
    "@types/pg": "8.23.1",
    "eslint": "^9.39.4",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
