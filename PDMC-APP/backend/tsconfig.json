{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": { "@backend/*": ["./src/*"] }
  },
  "include": ["src", "scripts", "prisma", "prisma.config.ts"],
  "exclude": ["node_modules", "generated"]
}
