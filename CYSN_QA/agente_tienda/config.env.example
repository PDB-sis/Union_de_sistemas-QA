API_URL=https://apiqa.apipalacio.com
AGENT_CODE=CODIGO_UNICO_DE_SUCURSAL
AGENT_TOKEN=TOKEN_UNICO_DE_MINIMO_32_CARACTERES
# auto = usa el driver más moderno instalado en la PC (18, 17, 13, 11, Native Client o "SQL Server").
SQL_DRIVER=auto
SQL_SERVER=CAJAUNO\SQLEXPRESS
SQL_DATABASE=BD_SPDV
SQL_USER=USUARIO_SOLO_LECTURA
SQL_PASSWORD=CLAVE
SQL_CONNECTION_TIMEOUT=10
# auto = intenta cifrado y, si el servidor o el driver no lo soportan, conecta sin cifrado (red local).
SQL_ENCRYPT=auto
SQL_TRUST_SERVER_CERTIFICATE=yes
# Tiendas: inventario. Bodegas: inventario,transferencias,devoluciones,usuarios
# (las consultas de esas tareas van en la carpeta "consultas", junto a este archivo).
TAREAS=inventario
SYNC_INTERVAL_SECONDS=60
OVERLAP_SECONDS=120
FULL_RECONCILIATION_HOURS=24
HTTP_TIMEOUT=30
STATE_PATH=C:\ProgramData\NexoQA\agente\state.sqlite3